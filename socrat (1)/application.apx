app SOCRAT (
    name: Socrat
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#logo/socrat-logo.svg
        text: SOCRAT
    }
    navigation {
        homeUrl: {
            page: 3
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        usersCanChooseThemeStyle: true
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    javaScript {
        fileUrls: [
            "#APP_FILES#js/theme-toggle.js "
            #APP_FILES#socrat-ui.js
            #APP_FILES#socrat-welcome.js
        ]
    }
    css {
        fileUrls: #APP_FILES#socrat-ui.css
    }
    authentication {
        scheme: @custom
    }
    globalization {
        primaryLanguage: ar-eg
        documentDirection: rightToLeft
        translationMethod: textMessages
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Socrat
        }
    )

)

