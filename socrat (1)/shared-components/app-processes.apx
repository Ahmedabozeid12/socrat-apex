appProcess set-theme-style (
    name: SET_THEME_STYLE
    source {
        plsqlCode:
            ```plsql
            declare
              l_style_id number;
            begin
              select theme_style_id
                into l_style_id
                from apex_application_theme_styles
               where application_id = :APP_ID
                 and theme_number   = 42
                    and name = case apex_application.g_x01
                              when 'light' then 'Socrat Light'
                              else 'Socrat Dark'
                            end;
            
              apex_theme.set_user_style(
                p_application_id => :APP_ID,
                p_user           => :APP_USER,
                p_theme_number   => 42,
                p_id             => l_style_id );
            
              htp.p('{"success":true}');
            end;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

