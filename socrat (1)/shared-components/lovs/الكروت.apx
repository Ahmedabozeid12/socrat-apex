lov الكروت (
    name: الكروت
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select '#' || c.job_card_id || ' – ' || v.make || ' ' || v.model || ' (' || v.plate_number || ')' as d,
                   c.job_card_id as r
              from job_cards c
              join vehicles v on v.vehicle_id = c.vehicle_id
             where c.status_id not in (7, 8)
             order by c.job_card_id desc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

