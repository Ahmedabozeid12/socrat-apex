page 9 (
    name: الأدوار والمستخدمين
    alias: الأدوار-والمستخدمين
    title: الأدوار والمستخدمين
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ROLE_ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P9_ROLE_ID', p_values => "ROLE_ID") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P9_ROLE_ID,'0') = "ROLE_ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("ROLE_NAME", 1, 50)||( case when length("ROLE_NAME") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("ROLE_NAME", 1, 50)||( case when length("ROLE_NAME") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "ROLES" x
                where (:P9_SEARCH is null
                        or upper(x."ROLE_NAME") like '%'||upper(:P9_SEARCH)||'%'
                        or upper(x."ROLE_NAME") like '%'||upper(:P9_SEARCH)||'%'
                    )
                order by "ROLE_NAME"
                ```
            pageItemsToSubmit: P9_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        messages {
            whenNoDataFound:
                ```
                لايوجد داتا
                
                ```
        }

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Link Attr
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Link Class
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: List Class
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 9
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column ROLE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Role Id
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region no-record-selected (
        name: No Record Selected
        type: staticContent
        source {
            htmlCode:
                ```html
                اختر دور وظيفي ومستخدم
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_ROLE_ID
        }
    )

    region region-display-selector (
        name: Region Display Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
            cssClasses: js-detail-rds
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ROLE_ID
        }
        settings {
            rememberSelection: false
        }
    )

    region roles (
        name: Roles
        title: الدور
        type: classicReport
        source {
            location: localDatabase
            tableName: ROLES
            whereClause: "ROLE_ID" = :P9_ROLE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ROLE_ID
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound:
                ```
                اختر دور
                
                ```
        }

        column MAX_DISCOUNT_PERCENT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: نسبة الخصم%
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ROLES"
                    where "MAX_DISCOUNT_PERCENT" is not null
                    and "ROLE_ID" = :P9_ROLE_ID
                    ```
            }
        )

        column ROLE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ROLES"
                    where "ROLE_ID" is not null
                    and "ROLE_ID" = :P9_ROLE_ID
                    ```
            }
        )

        column ROLE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: أسم الصلاحية
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ROLES"
                    where "ROLE_NAME" is not null
                    and "ROLE_ID" = :P9_ROLE_ID
                    ```
            }
        )

    )

    region search (
        name: بحث
        type: staticContent
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: [
                search-region
                padding-md
            ]
        }
    )

    region users (
        name: Users
        title: المستخدمين
        type: classicReport
        source {
            location: localDatabase
            tableName: USERS
            includeRowidColumn: true
            whereClause: "ROLE_ID" = :P9_ROLE_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: js-detail-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ROLE_ID
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound:
                ```
                اختر مستخدم
                
                ```
        }

        column FULL_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: <span class="fa fa-id-badge" aria-hidden="true"></span> الاسم الكامل
                alignment: end
            }
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
            }
        )

        column IS_ACTIVE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: حالة <span class="fa fa-toggle-on" aria-hidden="true"></span> الحالة
                alignment: end
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PASSWORD_USER (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: الرقم السري
                alignment: end
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ROLE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column USERNAME (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: <span class="fa fa-user" aria-hidden="true"></span> اسم المستخدم
                alignment: end
            }
            layout {
                sequence: 3
            }
            link {
                target: {
                    page: 13
                    items: {
                        P13_ROLE_ID: #ROLE_ID#
                        P13_USERNAME: #USERNAME#
                        P13_FULL_NAME: #FULL_NAME#
                        P13_IS_ACTIVE: #IS_ACTIVE#
                        P13_USER_ID: #USER_ID#
                        P13_PASSWORD_USER: #PASSWORD_USER#
                    }
                }
                linkText: #USERNAME#
            }
            sorting {
                defaultSequence: 1
            }
        )

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

    )

    pageItem P9_ROLE_ID (
        type: hidden
        layout {
            sequence: 40
            region: @roles
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_SEARCH (
        type: textField
        label {
            label: بحث
            alignment: left
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--postTextBlock
            ]
            icon: fa-search
            width: 30
            valuePlaceholder: Search...
        }
    )

    button create (
        buttonName: CREATE
        label: أنشاء دور وظيفي +
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button edit (
        buttonName: EDIT
        label: تعديل
        layout {
            sequence: 20
            region: @roles
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                items: {
                    P10_ROLE_ID: &P9_ROLE_ID.
                }
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: edit_master_btn
        }
    )

    button pop-users (
        buttonName: POP_USERS
        label: إضافة مستخدم
        layout {
            sequence: 10
            region: @users
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items: {
                    P13_ROLE_ID: &P9_ROLE_ID.
                }
                clearCache: 13
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: اعادة تحميل
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-refresh
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                clearCache: 9
                action: resetPagination
                request: RESET
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @users
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-2 (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @roles
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @roles
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P9_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

