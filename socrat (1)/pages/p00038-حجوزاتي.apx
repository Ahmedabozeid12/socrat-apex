            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column PLATE_NUMBER (
            type: plainText
            heading {
                heading: رقم اللوحة
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column STATUS_NAME (
            type: plainText
            heading {
                heading: حالة الحجز
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VEHICLE_NAME (
            type: plainText
            heading {
                heading: السيارة
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
