            displayColumn CUSTOMER_NOTES (
                sequence: 6
            )

            displayColumn PLATE_NUMBER (
                sequence: 2
            )

            displayColumn STATUS_NAME (
                sequence: 7
            )

            displayColumn VEHICLE_NAME (
                sequence: 3
            )

        )

    )

    pageItem P38_APPOINTMENT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @my-bookings
            slot: regionBody
        }
    )

    button add-appointment (
        buttonName: ADD_APPOINTMENT
        label: حجز موعد جديد
        layout {
            sequence: 10
            region: @my-bookings
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-calendar-plus-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                clearCache: 37
            }
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .s-cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var btn = this.triggeringElement;
                    var id  = btn.dataset.id;
                    var regionId = $(btn).closest('.t-IRR-region, .t-Region').attr('id');
                    
                    apex.message.confirm('متأكد إنك عاوز تلغي الحجز ده؟', function (ok) {
                      if (!ok) return;
                    
                      apex.server.process('CANCEL_BOOKING', { x01: id }, {
                        success: function (res) {
                          if (res.ok) {
                            apex.message.showPageSuccess('تم إلغاء الحجز ✅');
                            apex.region(regionId).refresh();
                          } else {
                            apex.message.alert('الحجز ده مينفعش يتلغى.');
                          }
                        },
                        error: function () {
                          apex.message.alert('حصل خطأ، حاول تاني.');
                        }
                      });
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process cancel-booking (
        name: CANCEL_BOOKING
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_count number;
                begin
                  update appointments a
                     set a.status = 'CANCELLED'
                   where a.appointment_id = to_number(apex_application.g_x01)
                     and a.customer_id    = to_number(:G_CUSTOMER_ID)
                     and a.status in ('PENDING', 'CONFIRMED')
                     and exists (select 1
                                   from appointment_slots s
                                  where s.slot_id  = a.slot_id
                                    and s.start_at > sysdate);
                  l_count := sql%rowcount;
                
                  apex_json.open_object;
                  apex_json.write('ok', l_count = 1);
                  apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 16238936531414521929
        }
    )

)

