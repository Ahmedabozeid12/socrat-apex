page 38 (
    name: حجوزاتي
    alias: حجوزاتي
    title: حجوزاتي
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region my-bookings (
        name: حجوزاتي
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.appointment_id,
                       v.plate_number,
                       v.make || ' ' || v.model                                   as vehicle_name,
                       to_char(s.start_at, 'FMDay DD FMMonth YYYY',
                               'NLS_DATE_LANGUAGE=ARABIC')                        as appointment_date,
                       to_char(s.start_at, 'FMHH:MI')
                         || case when to_char(s.start_at, 'HH24') < '12'
                                 then ' صباحًا' else ' مساءً' end                 as appointment_time,
                       a.customer_notes,
                       case a.status
                         when 'PENDING'   then 'قيد الانتظار'
                         when 'CONFIRMED' then 'تم التأكيد'
                         when 'CANCELLED' then 'ملغي'
                         when 'COMPLETED' then 'مكتمل'
                         else a.status
                       end                                                        as status_name,
                       case
                         when a.status in ('PENDING', 'CONFIRMED')
                          and s.start_at > sysdate
                         then '<button type="button" class="t-Button t-Button--small t-Button--danger s-cancel" data-id="'
                              || a.appointment_id
                              || '"><span class="fa fa-times-circle" aria-hidden="true"></span> إلغاء</button>'
                       end                                                        as cancel_btn
                  from appointments a
                  join vehicles v          on v.vehicle_id = a.vehicle_id
                  join appointment_slots s on s.slot_id    = a.slot_id
                 where a.customer_id = to_number(:G_CUSTOMER_ID)
                 order by s.start_at desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound:
                ```
                لاتوجد سيارة مسجلة لديك
                
                ```
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 14924640960071520566
        }

        column APPOINTMENT_DATE (
            type: plainText
            heading {
                heading: تاريخ الحجز
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column APPOINTMENT_ID (
            type: hidden
            heading {
