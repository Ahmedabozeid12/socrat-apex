page 10 (
    name: الادورار
    alias: ROLES
    title: الدور الوظيفي
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region roles (
        name: الادوار
        title: الدور الوظيفي
        type: form
        source {
            location: localDatabase
            tableName: ROLES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_MAX_DISCOUNT_PERCENT (
        type: numberField
        label {
            label: نسبة الخصم %
            alignment: left
        }
        settings {
            minValue: 0
            maxValue: 100
        }
        layout {
            sequence: 30
            region: @roles
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-percent
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @roles
            column: MAX_DISCOUNT_PERCENT
            dataType: number
        }
    )

    pageItem P10_ROLE_ID (
        type: numberField
        label {
            label: الرقم الوظيفي
            alignment: left
        }
        layout {
            sequence: 10
            region: @roles
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @roles
            column: ROLE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_ROLE_NAME (
        type: textField
        label {
            label: أسم الدور الوظيفي
            alignment: left
        }
        settings {
            textCase: upper
        }
        layout {
            sequence: 20
            region: @roles
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-shield
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @roles
            column: ROLE_NAME
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: الغاء
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: انشاء
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_ROLE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: حذف
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_ROLE_ID
        }
    )

    button save (
        buttonName: SAVE
        label: حفظ التعديلات
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_ROLE_ID
        }
    )

    process initialize-form-roles (
        name: Initialize form Roles
        type: formInitialization
        formRegion: @roles
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14862294076513642523
        }
    )

    process process-form-roles (
        name: Process form Roles
        type: formAutoRowProcessing
        formRegion: @roles
        execution {
            sequence: 10
        }
        successMessage {
            successMessage:
                ```
                تمت الأضافة بنجاح
                
                ```
        }
        advanced {
            executionMappingIdentifier: 14862294498682642524
        }
    )

    branch (
        name: Redirect to new
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9
                items: {
                    P9_ROLE_ID: &P10_ROLE_ID.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9
                action: resetPagination
            }
        }
    )

)

