page 13 (
    name: المستخدمين
    alias: المستخدمين
    title: المستخدمين
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region users (
        name: المستخدمين
        title: المستخدمين
        type: form
        source {
            location: localDatabase
            tableName: USERS
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P13_FULL_NAME (
        type: textField
        label {
            label: الأسم الكامل
            alignment: left
        }
        layout {
            sequence: 60
            region: @users
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-id-badge
            width: 60
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @users
            column: FULL_NAME
            dataType: varchar2
        }
    )

    pageItem P13_IS_ACTIVE (
        type: switch
        label {
            label: "حالة النشاط "
            alignment: left
        }
        layout {
            sequence: 70
            region: @users
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @users
            column: IS_ACTIVE
            dataType: varchar2
        }
    )

    pageItem P13_PASSWORD_USER (
        type: textField
        label {
            label: الرقم السري
            alignment: left
        }
        layout {
            sequence: 50
            region: @users
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-lock
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        source {
            formRegion: @users
            column: PASSWORD_USER
            dataType: varchar2
        }
    )

    pageItem P13_ROLE_ID (
        type: hidden
        layout {
            sequence: 30
            region: @users
            slot: regionBody
        }
        source {
            formRegion: @users
            column: ROLE_ID
            dataType: number
        }
    )

    pageItem P13_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @users
            slot: regionBody
        }
        source {
            formRegion: @users
            column: ROWID
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_USERNAME (
        type: textField
        label {
            label: "أسم المستخدم "
            alignment: left
        }
        settings {
            textCase: upper
        }
        layout {
            sequence: 40
            region: @users
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        source {
            formRegion: @users
            column: USERNAME
            dataType: varchar2
        }
    )

    pageItem P13_USER_ID (
        type: hidden
        layout {
            sequence: 20
            region: @users
            slot: regionBody
        }
        source {
            formRegion: @users
            column: USER_ID
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: الغاء
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: إضافة المستخدم
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P13_ROWID
        }
    )

    button delete (
        buttonName: DELETE
        label: حذف
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: s-btn-danger
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_ROWID
        }
    )

    button save (
        buttonName: SAVE
        label: حفظ التعديلات
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_ROWID
        }
    )

    process initialize-form-users (
        name: Initialize form Users
        type: formInitialization
        formRegion: @users
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14862331637462643391
        }
    )

    process process-form-users (
        name: Process form Users
        type: formAutoRowProcessing
        formRegion: @users
        execution {
            sequence: 10
        }
        successMessage {
            successMessage:
                ```
                تم الاضافه بنجاح
                
                ```
        }
        advanced {
            executionMappingIdentifier: 14862332001547643392
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9
                action: resetPagination
            }
        }
    )

)

