page 18 (
    name: الصفحة الرئيسية
    alias: الصفحة-الرئيسية
    title: Socrat
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            
            .star-home {
                direction: rtl;
                text-align: right;
            }
            
            .star-hero {
                min-height: 330px;
                display: flex;
                align-items: center;
                padding: 45px;
                border-radius: 18px;
                background: linear-gradient(120deg, #17191d, #343941);
                color: white;
                margin-bottom: 30px;
            }
            
            .star-hero-content {
                max-width: 700px;
            }
            
            .star-eyebrow {
                color: #f5b82e;
                font-weight: bold;
            }
            
            .star-hero h1 {
                font-size: 38px;
                margin: 18px 0;
                color: white;
            }
            
            .star-hero p {
                font-size: 17px;
                line-height: 2;
                color: #dedede;
            }
            
            .star-main-btn {
                display: inline-block;
                background: #f5b82e;
                color: #17191d !important;
                padding: 13px 28px;
                border-radius: 8px;
                text-decoration: none;
                font-weight: bold;
                margin-top: 15px;
            }
            
            .star-section {
                margin: 35px 0;
            }
            
            .star-section h2 {
                font-size: 25px;
                margin-bottom: 10px;
            }
            
            .star-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
                gap: 18px;
                margin-top: 22px;
            }
            
            .star-card {
                padding: 22px;
                border-radius: 12px;
                background: var(--ut-component-background-color);
                border: 1px solid var(--ut-component-border-color);
            }
            
            .star-card h3 {
                color: #d99c18;
                margin-top: 0;
            }
            
            .star-card p {
                line-height: 1.9;
                color: var(--ut-component-text-default-color);
            }
            
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region socrat (
        name: socrat
        title: socrat
        type: staticContent
        source {
            htmlCode:
                ```html
                <!--
                  SOCRAT - home page (Page 18)
                  Paste ALL of this into: Static Content region > Source > HTML Code
                  Region: Template = Blank with Attributes (no title bar)
                
                  Images: upload these to Static Application Files (exact names):
                    home-hero.jpg       svc-mechanic.jpg    svc-electric.jpg
                    svc-suspension.jpg  svc-bodywork.jpg    svc-parts.jpg     svc-wash.jpg
                  Until an image is uploaded, its card shows a dark gradient with the icon.
                
                  Links: replace PAGE_NO in each href with the real page number.
                -->
                
                <style>
                  .s-home { --o: #F5A623; --o2: #D98A0B; --line: rgba(128,128,128,.2); }
                  .s-home * { box-sizing: border-box; }
                  .s-home h2 { margin: 0 0 6px; font-size: 28px; font-weight: 800; }
                  .s-home .s-sub { margin: 0 0 22px; opacity: .7; }
                  .s-home section { margin-bottom: 48px; }
                
                  /* Hero */
                  .s-hero {
                    position: relative;
                    overflow: hidden;
                    padding: 64px 40px;
                    border-radius: 20px;
                    color: #fff;
                    background:
                      linear-gradient(270deg, rgba(10,10,10,.92) 0%, rgba(10,10,10,.75) 45%, rgba(10,10,10,.35) 100%),
                      url("#APP_FILES#home-hero.jpg") center / cover no-repeat,
                      linear-gradient(135deg, #262626, #0f0f0f);
                  }
                  .s-hero::after {
                    content: "";
                    position: absolute;
                    inset-inline-end: -80px;
                    bottom: -80px;
                    width: 260px;
                    height: 260px;
                    border-radius: 50%;
                    background: radial-gradient(circle, rgba(245,166,35,.35), transparent 70%);
                  }
                  .s-hero-tag {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 6px 14px;
                    border-radius: 999px;
                    background: rgba(245,166,35,.15);
                    color: var(--o);
                    font-weight: 700;
                    font-size: 13px;
                  }
                  .s-hero h1 { margin: 18px 0 12px; font-size: 44px; font-weight: 900; line-height: 1.25; }
                  .s-hero h1 span { color: var(--o); }
                  .s-hero p { max-width: 560px; margin: 0 0 28px; font-size: 16px; line-height: 1.9; opacity: .85; }
                  .s-actions { display: flex; flex-wrap: wrap; gap: 12px; position: relative; z-index: 1; }
                  .s-btn {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    padding: 13px 24px;
                    border-radius: 12px;
                    font-weight: 700;
                    text-decoration: none !important;
                    transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, color .2s ease;
                  }
                  .s-btn:hover { transform: translateY(-3px); }
                  .s-btn--primary { background: linear-gradient(135deg, var(--o), var(--o2)); color: #1a1a1a !important; }
                  .s-btn--primary:hover { box-shadow: 0 10px 26px rgba(245,166,35,.4); }
                  .s-btn--ghost { border: 1px solid rgba(255,255,255,.35); color: #fff !important; }
                  .s-btn--ghost:hover { background: #fff; color: #1a1a1a !important; }
                  .s-stats { display: flex; flex-wrap: wrap; gap: 36px; margin-top: 36px; position: relative; z-index: 1; }
                  .s-stats b { display: block; font-size: 26px; color: var(--o); }
                  .s-stats small { opacity: .75; }
                
                  /* Services */
                  .s-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
                  .s-svc {
                    display: block;
                    overflow: hidden;
                    border: 1px solid var(--line);
                    border-radius: 16px;
                    background: rgba(128,128,128,.05);
                    color: inherit !important;
                    text-decoration: none !important;
                    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
                  }
                  .s-svc:hover { transform: translateY(-6px); border-color: var(--o); box-shadow: 0 16px 34px rgba(0,0,0,.22); }
                  .s-svc-media { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: linear-gradient(135deg, #2b2b2b, #141414); }
                  .s-svc-img {
                    position: absolute;
                    inset: 0;
                    background: var(--img) center / cover no-repeat;
                    transition: transform .5s ease;
                  }
                  .s-svc:hover .s-svc-img { transform: scale(1.08); }
                  .s-svc-media::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(to top, rgba(0,0,0,.6), transparent 55%);
                  }
                  .s-svc-icon {
                    position: absolute;
                    z-index: 1;
                    bottom: 12px;
                    inset-inline-start: 12px;
                    display: grid;
                    place-items: center;
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: var(--o);
                    color: #1a1a1a;
                    font-size: 20px;
                    transition: transform .25s ease;
                  }
                  .s-svc:hover .s-svc-icon { transform: rotate(-8deg) scale(1.08); }
                  .s-svc-body { padding: 16px 18px 20px; }
                  .s-svc-body h3 { margin: 0 0 6px; font-size: 18px; font-weight: 800; color: var(--o); }
                  .s-svc-body p { margin: 0; font-size: 14px; line-height: 1.8; opacity: .8; }
                
                  /* Why us */
                  .s-why { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
                  .s-why-card {
                    display: flex;
                    gap: 14px;
                    padding: 22px;
                    border: 1px solid var(--line);
                    border-radius: 16px;
                    transition: border-color .25s ease, transform .25s ease;
                  }
                  .s-why-card:hover { border-color: var(--o); transform: translateY(-4px); }
                  .s-why-card .fa {
                    flex: none;
                    display: grid;
                    place-items: center;
                    width: 48px;
                    height: 48px;
                    border-radius: 14px;
                    background: rgba(245,166,35,.14);
                    color: var(--o);
                    font-size: 22px;
                  }
                  .s-why-card h3 { margin: 0 0 6px; font-size: 17px; font-weight: 800; }
                  .s-why-card p { margin: 0; font-size: 14px; line-height: 1.8; opacity: .8; }
                
                  /* Steps */
                  .s-steps { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); counter-reset: step; }
                  .s-step { position: relative; padding: 26px 20px 20px; border: 1px solid var(--line); border-radius: 16px; }
                  .s-step::before {
                    counter-increment: step;
                    content: "0" counter(step);
                    position: absolute;
                    top: -14px;
                    inset-inline-start: 18px;
                    padding: 2px 12px;
                    border-radius: 8px;
                    background: var(--o);
                    color: #1a1a1a;
                    font-weight: 800;
                    font-size: 13px;
                  }
                  .s-step .fa { font-size: 24px; color: var(--o); }
                  .s-step h3 { margin: 10px 0 6px; font-size: 17px; font-weight: 800; }
                  .s-step p { margin: 0; font-size: 14px; line-height: 1.8; opacity: .8; }
                
                  /* CTA */
                  .s-cta {
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: space-between;
                    gap: 18px;
                    padding: 30px 34px;
                    border-radius: 20px;
                    background: linear-gradient(135deg, var(--o), var(--o2));
                    color: #1a1a1a;
                  }
                  .s-cta h2 { margin: 0 0 4px; }
                  .s-cta p { margin: 0; opacity: .8; }
                  .s-cta .s-btn { background: #1a1a1a; color: #fff !important; }
                  .s-cta .s-btn:hover { box-shadow: 0 10px 24px rgba(0,0,0,.3); }
                
                  @media (max-width: 640px) {
                    .s-hero { padding: 40px 22px; }
                    .s-hero h1 { font-size: 30px; }
                  }
                  @media (prefers-reduced-motion: reduce) {
                    .s-home * { transition: none !important; }
                  }
                </style>
                
                <div class="s-home">
                
                  <!-- Hero -->
                  <section class="s-hero">
                    <span class="s-hero-tag"><span class="fa fa-star"></span> SOCRAT لصيانة السيارات الألمانية</span>
                    <h1>سيارتك في <span>أيدٍ أمينة</span></h1>
                    <p>نقدم خدمات صيانة وإصلاح السيارات باهتمام واحترافية، من استقبال سيارتك وحتى تسليمها في أفضل حالة.</p>
                    <div class="s-actions">
                      <a class="s-btn s-btn--primary" href="f?p=&APP_ID.:37:&SESSION.::&DEBUG.:::"><span class="fa fa-calendar"></span> احجز موعدك</a>
                      <a class="s-btn s-btn--ghost" href="f?p=&APP_ID.:33:&SESSION.::&DEBUG.:::"><span class="fa fa-car"></span> سجّل سيارتك</a>
                      <a class="s-btn s-btn--ghost" href="f?p=&APP_ID.:38:&SESSION.::&DEBUG.:::"><span class="fa fa-search"></span> تابع حجزك</a>
                    </div>
                    <div class="s-stats">
                      <div><b>+10</b><small>سنين خبرة</small></div>
                      <div><b>+2,000</b><small>سيارة اتصلحت</small></div>
                      <div><b>6</b><small>أقسام متخصصة</small></div>
                    </div>
                  </section>
                
                  <!-- Services -->
                  <section>
                    <h2>خدماتنا</h2>
                    <p class="s-sub">كل اللي تحتاجه سيارتك في مكان واحد</p>
                    <div class="s-grid">
                      <a class="s-svc" href="#">
                        <div class="s-svc-media">
                          <div class="s-svc-img" style="--img:url('#APP_FILES#sten-rademaker-UZUzvJEvKnI-unsplash.jpg')"></div>
                          <span class="s-svc-icon fa fa-wrench"></span>
                        </div>
                        <div class="s-svc-body"><h3>الصيانة الميكانيكية</h3><p>فحص وإصلاح الأعطال الميكانيكية.</p></div>
                      </a>
                      <a class="s-svc" href="#">
                        <div class="s-svc-media">
                          <div class="s-svc-img" style="--img:url('#APP_FILES#mehmet-talha-onuk-sEu9cAn7QLA-unsplash.jpg')"></div>
                          <span class="s-svc-icon fa fa-bolt"></span>
                        </div>
                        <div class="s-svc-body"><h3>كهرباء السيارات</h3><p>فحص وإصلاح الأنظمة الكهربائية.</p></div>
                      </a>
                      <a class="s-svc" href="#">
                        <div class="s-svc-media">
                          <div class="s-svc-img" style="--img:url('#APP_FILES#anastasiia-krutota-otf4dQgdNqo-unsplash.jpg')"></div>
                          <span class="s-svc-icon fa fa-cog"></span>
                        </div>
                        <div class="s-svc-body"><h3>العفشة والتعليق</h3><p>فحص أنظمة التعليق وتحسين أداء السيارة.</p></div>
                      </a>
                      <a class="s-svc" href="#">
                        <div class="s-svc-media">
                          <div class="s-svc-img" style="--img:url('#APP_FILES#erik-mclean-EpT-ZetoKm8-unsplash.jpg')"></div>
                          <span class="s-svc-icon fa fa-car"></span>
                        </div>
                        <div class="s-svc-body"><h3>السمكرة</h3><p>أعمال إصلاح هيكل السيارة.</p></div>
                      </a>
                      <a class="s-svc" href="#">
                        <div class="s-svc-media">
                          <div class="s-svc-img" style="--img:url('#APP_FILES#engin-akyurt--ShTRctVXlk-unsplash.jpg')"></div>
                          <span class="s-svc-icon fa fa-cubes"></span>
                        </div>
                        <div class="s-svc-body"><h3>قطع الغيار</h3><p>توفير قطع الغيار الأصلية اللازمة للصيانة.</p></div>
                      </a>
                      <a class="s-svc" href="#">
                        <div class="s-svc-media">
                          <div class="s-svc-img" style="--img:url('#APP_FILES#mintosko-V4b2j7f1dfc-unsplash.jpg')"></div>
                          <span class="s-svc-icon fa fa-tint"></span>
                        </div>
                        <div class="s-svc-body"><h3>غسيل السيارات</h3><p>العناية بنظافة السيارة ومظهرها.</p></div>
                      </a>
                    </div>
                  </section>
                
                  <!-- Why us -->
                  <section>
                    <h2>ليه SOCRAT؟</h2>
                    <p class="s-sub">بنهتم بكل تفصيلة في سيارتك</p>
                    <div class="s-why">
                      <div class="s-why-card">
                        <span class="fa fa-list-ol"></span>
                        <div><h3>تنظيم في الشغل</h3><p>متابعة مراحل صيانة السيارة بوضوح.</p></div>
                      </div>
                      <div class="s-why-card">
                        <span class="fa fa-users"></span>
                        <div><h3>فريق متخصص</h3><p>فنيين متخصصين في مجالات الصيانة المختلفة.</p></div>
                      </div>
                      <div class="s-why-card">
                        <span class="fa fa-calendar-check-o"></span>
                        <div><h3>سهولة الحجز</h3><p>احجز موعدك إلكترونيًا من غير ما تحتاج تتصل.</p></div>
                      </div>
                    </div>
                  </section>
                
                  <!-- Steps -->
                  <section>
                    <h2>إزاي بنخدم سيارتك؟</h2>
                    <p class="s-sub">4 خطوات بسيطة من الحجز للتسليم</p>
                    <div class="s-steps">
                      <div class="s-step"><span class="fa fa-calendar"></span><h3>الحجز</h3><p>اختار سيارتك والموعد المناسب واكتب شكوتك.</p></div>
                      <div class="s-step"><span class="fa fa-sign-in"></span><h3>الاستقبال</h3><p>فريق المركز يستقبل سيارتك ويسجل أمر الشغل.</p></div>
                      <div class="s-step"><span class="fa fa-wrench"></span><h3>الفحص والصيانة</h3><p>فحص السيارة وتنفيذ الأعمال المطلوبة.</p></div>
                      <div class="s-step"><span class="fa fa-check-circle"></span><h3>التسليم</h3><p>استلم سيارتك بعد ما الشغل يخلص.</p></div>
                    </div>
                  </section>
                
                  <!-- CTA -->
                  <section class="s-cta">
                    <div>
                      <h2>جاهز تحجز؟</h2>
                      <p>احجز موعدك دلوقتي وإحنا هنهتم بالباقي.</p>
                    </div>
                    <a class="s-btn" href="f?p=&APP_ID.:37:&SESSION.::&DEBUG.:::"><span class="fa fa-calendar-plus-o"></span> احجز موعد</a>
                  </section>
                
                </div>
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

)

