page 27 (
    name: اضافة مورد
    alias: اضافة-مورد
    title: اضافة مورد
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region اضافة-مورد (
        name: اضافة مورد
        type: form
        source {
            location: localDatabase
            tableName: SUPPLIERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P27_ADDRESS (
        type: textField
        label {
            label: العنوان
            alignment: left
        }
        layout {
            sequence: 50
            region: @اضافة-مورد
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-map-marker
            width: 60
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @اضافة-مورد
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P27_PHONE (
        type: textField
        label {
            label: رقم التليفون
            alignment: left
        }
        settings {
            subtype: phone
        }
        layout {
            sequence: 30
            region: @اضافة-مورد
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-phone
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @اضافة-مورد
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P27_SUPPLIER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @اضافة-مورد
            slot: regionBody
        }
        source {
            formRegion: @اضافة-مورد
            column: SUPPLIER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P27_SUPPLIER_NAME (
        type: textField
        label {
            label: اسم المورد
            alignment: left
        }
        layout {
            sequence: 20
            region: @اضافة-مورد
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-truck
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @اضافة-مورد
            column: SUPPLIER_NAME
            dataType: varchar2
        }
    )

    pageItem P27_TAX_NUMBER (
        type: textField
        label {
            label: الرقم الضريبي
            alignment: left
        }
        layout {
            sequence: 40
            region: @اضافة-مورد
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-file-text-o
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @اضافة-مورد
            column: TAX_NUMBER
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: الغاء
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: إضافة المورد
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P27_SUPPLIER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: حذف
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: fa-trash-o
            icon: s-btn-danger
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P27_SUPPLIER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: حفظ
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P27_SUPPLIER_ID
        }
    )

    validation اسم-المورد (
        name: اسم المورد
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P27_SUPPLIER_NAME
        }
        error {
            errorMessage:
                ```
                لابد من ادخال اسم المورد
                
                ```
            associatedItem: @P27_SUPPLIER_NAME
        }
    )

    validation تكرار-الاسم (
        name: تكرار الاسم
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    V_COUNT NUMBER;
                BEGIN
                    IF :P21_PHONE IS NULL THEN
                        RETURN TRUE;
                    END IF;
                
                    SELECT COUNT(*)
                    INTO V_COUNT
                    FROM SUPPLIERS
                    WHERE PHONE = TRIM(:P21_PHONE)
                      AND SUPPLIER_ID <> NVL(:P21_SUPPLIER_ID, -1);
                
                    RETURN V_COUNT = 0;
                END;
                ```
        }
        error {
            errorMessage:
                ```
                هذا الرقم مسجل بالفعل
                
                ```
            associatedItem: @P27_PHONE
        }
    )

    validation تكرار-الرقم-الضريبي (
        name: تكرار الرقم الضريبي
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    V_COUNT NUMBER;
                BEGIN
                    IF :P21_TAX_NUMBER IS NULL THEN
                        RETURN TRUE;
                    END IF;
                
                    SELECT COUNT(*)
                    INTO V_COUNT
                    FROM SUPPLIERS
                    WHERE TAX_NUMBER = TRIM(:P21_TAX_NUMBER)
                      AND SUPPLIER_ID <> NVL(:P21_SUPPLIER_ID, -1);
                
                    RETURN V_COUNT = 0;
                END;
                ```
        }
        error {
            errorMessage:
                ```
                الرقم الضريبي مسجل بالفعل
                
                ```
            associatedItem: @P27_TAX_NUMBER
        }
    )

    validation رقم-الهاتف (
        name: رقم الهاتف
        execution {
            sequence: 20
        }
        validation {
            type: itemMatchesRegexp
            item: P27_PHONE
            regexp: "^01[0-9]{9}$"
        }
        error {
            errorMessage:
                ```
                الرقم لابد ان يبدا 010 و9 ارقام
                
                ```
            associatedItem: @P27_PHONE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 14467123852412174903
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-اضافة-مورد (
        name: Initialize form اضافة مورد
        type: formInitialization
        formRegion: @اضافة-مورد
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14467123076475174902
        }
    )

    process process-form-اضافة-مورد (
        name: Process form اضافة مورد
        type: formAutoRowProcessing
        formRegion: @اضافة-مورد
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: تمت أضافة مورد بنجاح
        }
        advanced {
            executionMappingIdentifier: 14467123468588174903
        }
    )

)

