    button cancel (
        buttonName: CANCEL
        label: إلغاء
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: إضافة الصنف
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_PART_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: حذف
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: s-btn-danger
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_PART_ID
        }
    )

    button save (
        buttonName: SAVE
        label: حفظ
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_PART_ID
        }
    )

    validation اكتب-اسم-الصنف (
        name: اكتب اسم الصنف
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P11_PART_NAME
        }
        error {
            errorMessage:
                ```
                اكتب اسم الصنف
                
                ```
            associatedItem: @P11_PART_NAME
        }
    )

    validation الحد-الادني (
        name: الحد الادني
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: nvl(to_number(:P11_REORDER_LEVEL), 0) >= 0
        }
        error {
            errorMessage:
                ```
                الحد الادني لايمكن ان يكون بالسالب
                
                ```
            associatedItem: @P11_REORDER_LEVEL
        }
    )

    validation السعر (
        name: السعر
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: nvl(to_number(:P11_UNIT_COST), 0) >= 0
        }
        error {
            errorMessage:
                ```
                السعر لايمكن ان يكون بالسالب
                
                ```
            associatedItem: @P11_UNIT_COST
        }
    )

    validation السعر_1 (
        name: السعر
        execution {
            sequence: 60
        }
        validation {
            plsqlExpression: nvl(to_number(:P11_SELLING_PRICE), 0) >= 0
        }
        error {
            errorMessage:
                ```
                سعر البيع لايمكن ان يكون بالسالب
                
                ```
            associatedItem: @P11_SELLING_PRICE
        }
    )

    validation الكمية (
        name: الكمية
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: nvl(to_number(:P11_QUANTITY_ON_HAND), 0) >= 0
        }
        error {
            errorMessage:
                ```
                الكمية لايمكن ان تكون سالبة
                
                ```
            associatedItem: @P11_QUANTITY_ON_HAND
        }
    )

    validation الكود-مكرر (
        name: الكود مكرر
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from parts
                where upper(trim(part_code)) = upper(trim(:P41_PART_CODE))
                  and part_id <> nvl(:P41_PART_ID, -1)
                ```
        }
        error {
            errorMessage: كود الصنف ده مسجل بالفعل
            associatedItem: @P11_PART_CODE
        }
    )

    validation كود-الصنف (
        name: كود الصنف
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P11_PART_CODE
        }
        error {
            errorMessage: اكتب كود الصنف
            associatedItem: @P11_PART_CODE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 14250914026176069917
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-اصافة-صنف (
        name: Initialize form اصافة صنف
        type: formInitialization
        formRegion: @اصافة-صنف
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14250913004463069916
        }
    )

    process process-form-اصافة-صنف (
        name: Process form اصافة صنف
        type: formAutoRowProcessing
        formRegion: @اصافة-صنف
        execution {
            sequence: 10
        }
        successMessage {
            successMessage:
                ```
                تم أضافة الصنف بنجاح
                
                ```
        }
        advanced {
            executionMappingIdentifier: 14250913589131069917
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

