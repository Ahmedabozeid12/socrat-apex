        settings {
            maxValue: 0
        }
        layout {
            sequence: 80
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-money
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @اصافة-صنف
            column: SELLING_PRICE
            dataType: number
        }
    )

    pageItem P11_UNIT (
        type: textField
        label {
            label: الوحدة
            alignment: left
        }
        layout {
            sequence: 50
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
