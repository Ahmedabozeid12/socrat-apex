        layout {
            sequence: 70
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-money
            width: 32
