page 11 (
    name: اصافة صنف
    alias: اصافة-صنف
    title: اصافة صنف
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region اصافة-صنف (
        name: اصافة صنف
        type: form
        source {
            location: localDatabase
            tableName: PARTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P11_CATEGORY (
        type: textField
        label {
            label: الصنف
            alignment: left
        }
        layout {
            sequence: 40
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-folder-o
            width: 32
        }
        validation {
            maxLength: 60
        }
        source {
            formRegion: @اصافة-صنف
            column: CATEGORY
            dataType: varchar2
        }
    )

    pageItem P11_PART_CODE (
        type: textField
        label {
            label: كود الصنف
            alignment: left
        }
        layout {
            sequence: 20
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-barcode
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            formRegion: @اصافة-صنف
            column: PART_CODE
            dataType: varchar2
        }
    )

    pageItem P11_PART_ID (
        type: hidden
        layout {
            sequence: 10
            region: @اصافة-صنف
            slot: regionBody
        }
        source {
            formRegion: @اصافة-صنف
            column: PART_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_PART_NAME (
        type: textField
        label {
            label: اسم الصنف
            alignment: left
        }
        layout {
            sequence: 30
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-tag
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @اصافة-صنف
            column: PART_NAME
            dataType: varchar2
        }
    )

    pageItem P11_QUANTITY_ON_HAND (
        type: numberField
        label {
            label: الكمية
            alignment: left
        }
        settings {
            maxValue: 0
        }
        layout {
            sequence: 60
            region: @اصافة-صنف
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-cubes
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @اصافة-صنف
            column: QUANTITY_ON_HAND
            dataType: number
        }
    )

