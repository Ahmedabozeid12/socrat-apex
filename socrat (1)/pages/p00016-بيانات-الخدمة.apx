page 16 (
    name: بيانات الخدمة
    alias: بيانات-الخدمة
    title: بيانات الخدمة
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region بيانات-الخدمة (
        name: بيانات الخدمة
        type: form
        source {
            location: localDatabase
            tableName: SERVICES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P16_CATEGORY (
        type: textField
        label {
            label: التصنيف
            alignment: left
        }
        layout {
            sequence: 30
            region: @بيانات-الخدمة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-folder-o
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @بيانات-الخدمة
            column: CATEGORY
            dataType: varchar2
        }
    )

    pageItem P16_ESTIMATED_MINUTES (
        type: numberField
        label {
            label: لوقت المتوقع (دقيقة)
            alignment: left
        }
        settings {
            minValue: 5
        }
        layout {
            sequence: 50
            region: @بيانات-الخدمة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-clock-o
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @بيانات-الخدمة
            column: ESTIMATED_MINUTES
            dataType: number
        }
    )

    pageItem P16_IS_ACTIVE (
        type: switch
        label {
            label: الحالة
            alignment: left
        }
        layout {
            sequence: 60
            region: @بيانات-الخدمة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @بيانات-الخدمة
            column: IS_ACTIVE
            dataType: varchar2
        }
    )

    pageItem P16_SERVICE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @بيانات-الخدمة
            slot: regionBody
        }
        source {
            formRegion: @بيانات-الخدمة
            column: SERVICE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_SERVICE_NAME (
        type: textField
        label {
            label: اسم الخدمة
            alignment: left
        }
        layout {
            sequence: 20
            region: @بيانات-الخدمة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-wrench
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @بيانات-الخدمة
            column: SERVICE_NAME
            dataType: varchar2
        }
    )

    pageItem P16_STANDARD_PRICE (
        type: numberField
        label {
            label: السعر (ج.م)
            alignment: left
        }
        settings {
            minValue: 1
        }
        layout {
            sequence: 40
            region: @بيانات-الخدمة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-money
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @بيانات-الخدمة
            column: STANDARD_PRICE
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: إلغاء
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: إضافة الخدمة
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_SERVICE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_SERVICE_ID
        }
    )

    button save (
        buttonName: SAVE
        label: حفظ التعديلات
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_SERVICE_ID
        }
    )

    validation اسم-الخدمة (
        name: اسم الخدمة
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P16_SERVICE_NAME
        }
        error {
            errorMessage: اكتب اسم الخدمة
            associatedItem: @P16_SERVICE_NAME
        }
    )

    validation السعر (
        name: السعر
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: nvl(to_number(:P16_STANDARD_PRICE), 0) > 0
        }
        error {
            errorMessage: السعر لازم يكون أكبر من صفر
            associatedItem: @P16_STANDARD_PRICE
        }
    )

    validation الوقت (
        name: الوقت
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: :P16_ESTIMATED_MINUTES is null or to_number(:P16_ESTIMATED_MINUTES) >= 0
        }
        error {
            errorMessage: الوقت المتوقع لا يمكن أن يكون سالب
            associatedItem: @P16_ESTIMATED_MINUTES
        }
    )

    validation تكرار-الخدمة (
        name: تكرار الخدمة
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from services
                where upper(trim(service_name)) = upper(trim(:P16_SERVICE_NAME))
                  and service_id <> nvl(:P16_SERVICE_ID, -1)
                ```
        }
        error {
            errorMessage: الخدمة دي مسجلة بالفعل
            associatedItem: @P16_SERVICE_NAME
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 14434993205085978495
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-بيانات-الخدمة (
        name: Initialize form بيانات الخدمة
        type: formInitialization
        formRegion: @بيانات-الخدمة
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14434992482398978494
        }
    )

    process process-form-بيانات-الخدمة (
        name: Process form بيانات الخدمة
        type: formAutoRowProcessing
        formRegion: @بيانات-الخدمة
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14434992816382978495
        }
    )

)

