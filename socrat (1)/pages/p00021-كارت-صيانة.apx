    button add-service (
        buttonName: add_service
        label: +خدمة
        layout {
            sequence: 10
            region: @الخدمات-المطلوبة
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
    )

    button cancel (
        buttonName: CANCEL
        label: الغاء
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: حفظ
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_JOB_CARD_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: حذف الكارت
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            cssClasses: s-btn-danger
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_JOB_CARD_ID
        }
    )

    button save (
        buttonName: SAVE
        label: حفظ التعديلات
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_JOB_CARD_ID
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @الخدمات-المطلوبة
            columns: SERVICE_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select standard_price from services where service_id = :SERVICE_ID
                itemsToSubmit: SERVICE_ID
            }
            affectedElements {
                selectionType: columns
                columns: UNIT_PRICE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @add-service
        }

        action native-show (
            action: executeJsCode
            settings {
                jsCode: var $g=$(".a-IG").first(); $g.interactiveGrid("getActions").set("edit",true); $g.interactiveGrid("getViews","grid").model.insertNewRecord();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation العداد (
        name: العداد
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from job_cards
                where vehicle_id = :P21_VEHICLE_ID
                  and odometer_reading > :P21_ODOMETER_READING
                  and (:P21_JOB_CARD_ID is null or job_card_id < :P21_JOB_CARD_ID)
                ```
        }
        error {
            errorMessage: قراءة العداد أقل من آخر قراءة مسجلة للسيارة دي
            associatedItem: @P21_ODOMETER_READING
        }
    )

    validation الكارت-الجديد (
        name: الكارت الجديد
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P21_JOB_CARD_ID is null
                  and to_number(:P21_STATUS_ID) <> 1
                ```
        }
        error {
            errorMessage: الكارت الجديد لازم يبدأ بحالة (جديد)
            associatedItem: @P21_STATUS_ID
        }
    )

    validation كارت-مفتوح (
        name: كارت مفتوح
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from job_cards
                where vehicle_id = :P21_VEHICLE_ID
                  and status_id not in (7, 8)
                  and job_card_id <> nvl(:P21_JOB_CARD_ID, -1)
                ```
        }
        error {
            errorMessage: السيارة دي عليها كارت مفتوح بالفعل
            associatedItem: @P21_VEHICLE_ID
        }
    )

    validation كارت-مقفول (
        name: كارت مقفول
        execution {
            sequence: 50
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from job_cards
                where job_card_id = :P21_JOB_CARD_ID
                  and status_id in (7, 8)
                ```
        }
        error {
            errorMessage: الكارت ده مقفول (تم التسليم أو ملغي) ومينفعش يتعدل
            associatedItem: @P21_STATUS_ID
        }
    )

    validation موعد-التسليم (
        name: موعد التسليم
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P21_EXPECTED_DELIVERY_DATE is not null
                  and trunc(to_date(:P21_EXPECTED_DELIVERY_DATE, 'DD/MM/YYYY')) < trunc(sysdate)
                ```
        }
        error {
            errorMessage: موعد التسليم لا يمكن أن يكون قبل تاريخ فتح الكارت
            associatedItem: @P21_EXPECTED_DELIVERY_DATE
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_JOB_CARD_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        error {
            errorMessage: لللللل
        }
        advanced {
