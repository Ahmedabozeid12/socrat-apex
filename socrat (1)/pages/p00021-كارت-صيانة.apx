page 21 (
    name: "كارت صيانة "
    alias: كارت-صيانة
    title: كارت صيانة
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region الخدمات-المطلوبة (
        name: الخدمات المطلوبة
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select job_card_service_id, job_card_id, service_id, technician_id,
                       quantity, unit_price, line_status, notes
                  from job_card_services
                 where job_card_id = :P21_JOB_CARD_ID
                ```
            pageItemsToSubmit: P21_JOB_CARD_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_JOB_CARD_ID
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 14444586642364764030
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @JOB_CARD_SERVICE_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @JOB_CARD_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SERVICE_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
