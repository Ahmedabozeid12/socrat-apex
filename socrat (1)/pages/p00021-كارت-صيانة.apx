                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @NOTES
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column JOB_CARD_ID (
            type: hidden
            heading {
                heading: Job Card Id
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: JOB_CARD_ID
                dataType: number
            }
