    )

    process تاكيد-الحجز_1 (
        name: CONFIRM_APPOINTMENT_AJAX
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    L_ID NUMBER;
                BEGIN
                    IF NVL(V('G_USER_TYPE'), 'CUSTOMER') <> 'EMPLOYEE' THEN
                        RAISE_APPLICATION_ERROR(-20003, 'Not authorized.');
                    END IF;
                
                    L_ID := TO_NUMBER(APEX_APPLICATION.G_X01);
                
                    UPDATE APPOINTMENTS
                    SET STATUS = 'CONFIRMED'
                    WHERE APPOINTMENT_ID = L_ID
                      AND STATUS = 'PENDING';
                
                    IF SQL%ROWCOUNT = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Appointment cannot be confirmed.'
                        );
                    END IF;
                
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('success', TRUE);
                    APEX_JSON.WRITE('message', 'تم تأكيد الحجز بنجاح');
                    APEX_JSON.CLOSE_OBJECT;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', FALSE);
                        APEX_JSON.WRITE('message', SQLERRM);
                        APEX_JSON.CLOSE_OBJECT;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 14912136227913701731
        }
    )

)

