    region إدارة-حجوزات-العملاء (
        name: إدارة حجوزات العملاء
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    A.APPOINTMENT_ID,
                    C.FULL_NAME,
                    C.PHONE,
                    V.PLATE_NUMBER,
                    V.MAKE || ' ' || V.MODEL AS VEHICLE_NAME,
                
                    TO_CHAR(
                        S.START_AT,
                        'FMDay DD FMMonth YYYY',
                        'NLS_DATE_LANGUAGE=ARABIC'
                    ) AS APPOINTMENT_DATE,
                
                    TO_CHAR(S.START_AT, 'HH:MI AM')
                    || CASE
                        WHEN TO_CHAR(S.START_AT, 'HH24') < '12'
                        THEN ' صباحًا'
                        ELSE ' مساءً'
                    END AS APPOINTMENT_TIME,
                
                    A.CUSTOMER_NOTES,
                    A.STATUS,
                CASE
                    WHEN A.STATUS = 'PENDING' THEN
                        '<a href="javascript:void(0)"
                            class="confirm-appointment"
                            data-id="' || A.APPOINTMENT_ID || '">
                            تأكيد الحجز
                        </a>'
                END AS CONFIRM_ACTION,
                
                CASE
                    WHEN A.STATUS IN ('PENDING', 'CONFIRMED') THEN
                        '<a href="javascript:void(0)"
                            class="cancel-appointment"
                            data-id="' || A.APPOINTMENT_ID || '">
                            إلغاء الحجز
                        </a>'
                END AS CANCEL_ACTION
                
                FROM APPOINTMENTS A,
                     CUSTOMERS C,
                     VEHICLES V,
                     APPOINTMENT_SLOTS S
                
                WHERE A.CUSTOMER_ID = C.CUSTOMER_ID
                  AND A.VEHICLE_ID = V.VEHICLE_ID
                  AND A.SLOT_ID = S.SLOT_ID
                
                ORDER BY S.START_AT DESC;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
