    dynamicAction الغاء (
        name: الغاء
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .cancel-appointment
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var appointmentId = this.triggeringElement.dataset.id;
                    
                    apex.message.confirm(
                        "هل أنت متأكد من إلغاء هذا الحجز؟",
                        function (okPressed) {
                    
                            if (!okPressed) {
                                return;
                            }
                    
                            apex.server.process(
                                "CANCEL_APPOINTMENT_AJAX",
                                {
                                    x01: appointmentId
                                },
                                {
                                    dataType: "json",
                                    success: function (data) {
                                        if (data.success) {
                                            apex.message.showPageSuccess(data.message);
                                            apex.region("APPOINTMENTS_REPORT").refresh();
                                        } else {
                                            apex.message.alert(data.message);
                                        }
                                    },
                                    error: function () {
                                        apex.message.alert("حدث خطأ أثناء إلغاء الحجز.");
                                    }
                                }
                            );
                        }
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction تاكيد (
        name: تاكيد
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .confirm-appointment
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var appointmentId = this.triggeringElement.dataset.id;
                    
                    apex.server.process(
                        "CONFIRM_APPOINTMENT_AJAX",
                        {
                            x01: appointmentId
                        },
                        {
                            dataType: "json",
                            success: function (data) {
                                if (data.success) {
                                    apex.message.showPageSuccess(data.message);
                                    apex.region("APPOINTMENTS_REPORT").refresh();
                                } else {
                                    apex.message.alert(data.message);
                                }
                            },
                           error: function (jqXHR, textStatus, errorThrown) {
                        console.log("AJAX Status:", textStatus);
                        console.log("Error:", errorThrown);
                        console.log("Response:", jqXHR.responseText);
                    
                        apex.message.alert(
                            "حدث خطأ: " + textStatus +
                            "\nالتفاصيل: " + errorThrown +
                            "\nResponse: " + jqXHR.responseText
                        );
                    }
                        }
                    );
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process الغاء-الحجز (
        name: الغاء الحجز
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE APPOINTMENTS
                SET STATUS = 'CANCELLED'
                WHERE APPOINTMENT_ID = :P40_APPOINTMENT_ID
                  AND STATUS IN ('PENDING', 'CONFIRMED');
                
                IF SQL%ROWCOUNT = 0 THEN
                    RAISE_APPLICATION_ERROR(
                        -20002,
                        'Appointment cannot be cancelled.'
                    );
                END IF;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14912135192367701720
        }
    )

    process الغاء-الحجز_1 (
        name: CANCEL_APPOINTMENT_AJAX
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    L_ID NUMBER;
                BEGIN
                    L_ID := TO_NUMBER(APEX_APPLICATION.G_X01);
                
                    UPDATE APPOINTMENTS
                    SET STATUS = 'CANCELLED'
                    WHERE APPOINTMENT_ID = L_ID
                      AND STATUS IN ('PENDING', 'CONFIRMED');
                
                    IF SQL%ROWCOUNT = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20002,
                            'Appointment cannot be cancelled.'
                        );
                    END IF;
                
                    COMMIT;
                
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('success', TRUE);
                    APEX_JSON.WRITE('message', 'تم إلغاء الحجز بنجاح');
                    APEX_JSON.CLOSE_OBJECT;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', FALSE);
                        APEX_JSON.WRITE('message', SQLERRM);
                        APEX_JSON.CLOSE_OBJECT;
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 14912136305585701732
        }
    )

    process تاكيد-الحجز (
        name: تاكيد الحجز
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE APPOINTMENTS
                SET STATUS = 'CONFIRMED'
                WHERE APPOINTMENT_ID = :P40_APPOINTMENT_ID
                  AND STATUS = 'PENDING';
                
                IF SQL%ROWCOUNT = 0 THEN
                    RAISE_APPLICATION_ERROR(
                        -20001,
                        'Appointment cannot be confirmed.'
