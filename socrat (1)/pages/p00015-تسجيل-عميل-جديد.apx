page 15 (
    name: تسجيل عميل جديد
    alias: تسجيل-عميل-جديد
    title: تسجيل عميل جديد
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            #signup-card{
              max-width:680px;
              margin:32px auto;
              border-radius:16px;
            }
            ```
    }
    security {
        authentication: public
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region تسجيل-العملاء (
        name: تسجيل العملاء
        title: إنشاء حساب جديد
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P15_ADDRESS (
        type: textField
        label {
            label: العنوان
            alignment: left
        }
        layout {
            sequence: 70
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-map-marker
            width: 30
        }
    )

    pageItem P15_CUSTOMER_TYPE (
        type: selectList
        label {
            label: نوع العميل
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:فردي;INDIVIDUAL,شركة;COMPANY
        }
        layout {
            sequence: 80
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-users
            height: 1
        }
    )

    pageItem P15_FULL_NAME (
        type: textField
        label {
            label: الاسم الكامل
            alignment: left
        }
        layout {
            sequence: 10
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P15_GENDER (
        type: selectList
        label {
            label: الجنس
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:ذكر;MALE,مؤنث;FEMALE
        }
        layout {
            sequence: 90
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-venus-mars
            height: 1
        }
    )

    pageItem P15_NATIONAL_ID (
        type: textField
        label {
            label: الرقم القومي
            alignment: left
        }
        layout {
            sequence: 60
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-id-card-o
            width: 30
        }
    )

    pageItem P15_PASSWORD (
        type: password
        label {
            label: كلمة المرور
            alignment: left
        }
        layout {
            sequence: 100
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-lock
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P15_PASSWORD1 (
        type: password
        label {
            label: تأكيد كلمة المرور
            alignment: left
        }
        layout {
            sequence: 110
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-lock
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P15_PHONE (
        type: textField
        label {
            label: رقم الهاتف
            alignment: left
        }
        layout {
            sequence: 20
            region: @تسجيل-العملاء
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-phone
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    button btn-register (
        buttonName: BTN_REGISTER
        label: إنشاء الحساب
        layout {
            sequence: 20
            region: @تسجيل-العملاء
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: s-pill
            icon: fa-user-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button الغاء (
        buttonName: الغاء
        label: الغاء
        layout {
            sequence: 30
            region: @تسجيل-العملاء
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    validation passowrd-mathch (
        name: PASSOWRD_MATHCH
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                BEGIN
                    IF :P15_PASSWORD!= :P15_PASSWORD1_ THEN
                        RETURN 'كلمة السر غير متطابقة';
                    END IF;
                
                    RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @btn-register
        }
    )

    validation الرقم-القومي (
        name: الرقم القومي
        execution {
            sequence: 40
        }
        validation {
            type: itemMatchesRegexp
            item: P15_NATIONAL_ID
            regexp: "^[23][0-9]{13}$"
        }
        error {
            errorMessage: هذا الرقم القومي غير صالح لابد ان يحتوي علي 14 رقم
            associatedItem: @P15_NATIONAL_ID
        }
    )

    validation تكرار-رقم-الهاتف (
        name: تكرار رقم الهاتف
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery: select 1 from customers where phone = :P15_PHONE
        }
        error {
            errorMessage:
                ```
                هذا الرقم مسجل بالفعل
                
                ```
            associatedItem: @P15_PHONE
        }
    )

    validation رقم-الهاتف (
        name: رقم الهاتف
        execution {
            sequence: 20
        }
        validation {
            type: itemMatchesRegexp
            item: P15_PHONE
            regexp: "^01[0125][0-9]{8}$"
        }
        error {
            errorMessage: لابد ان يحتوي رقم التليفون علي 010 او 011 او  012 او 015 و8 ارقام
            associatedItem: @P15_PHONE
        }
    )

    process new (
        name: التسجيل
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_CUSTOMER_ID NUMBER;
                    V_COUNT       NUMBER;
                    V_PASSWORD_HASH VARCHAR2(128);
                BEGIN
                
                    -- Validate phone
                    IF NOT REGEXP_LIKE(
                        :P15_PHONE,
                        '^01[0125][0-9]{8}$'
                    ) THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Invalid mobile number.'
                        );
                    END IF;
                
                    -- Validate name
                    IF TRIM(:P15_FULL_NAME) IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20002,
                            'Customer name is required.'
                        );
                    END IF;
                
                     IF LENGTH(TRIM(:P15_NATIONAL_ID)) != 14
                       OR NOT REGEXP_LIKE(:P15_NATIONAL_ID, '^[0-9]{14}$') THEN
                        RAISE_APPLICATION_ERROR(-20002, 'Invalid National ID.');
                    END IF;
                
                    -- Validate password
                    IF LENGTH(:P15_PASSWORD) < 8 THEN
                        RAISE_APPLICATION_ERROR(
                            -20003,
                            'Password must be at least 8 characters.'
                        );
                    END IF;
                
                    -- Check password confirmation
                    IF :P15_PASSWORD!= :P15_PASSWORD1 THEN
                        RAISE_APPLICATION_ERROR(
                            -20004,
                            'Password confirmation does not match.'
                        );
                    END IF;
                
                    -- Check duplicate phone
                    SELECT COUNT(*)
                    INTO V_COUNT
                    FROM CUSTOMERS
                    WHERE PHONE = :P15_PHONE;
                
                    IF V_COUNT > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20005,
                            'This mobile number is already registered.'
                        );
                    END IF;
                
                    -- Generate password hash
                    V_PASSWORD_HASH :=
                        hash_passowrd_simplee(:P15_PASSWORD);
                
                    -- Insert customer
                   
                    INSERT INTO CUSTOMERS (
                        FULL_NAME,
                        PHONE,
                        NATIONAL_ID,
                        ADDRESS,
                        CUSTOMER_TYPE,
                        GENDER
                    )
                    VALUES (
                        TRIM(:P15_FULL_NAME),
                        :P15_PHONE,
                        :P15_NATIONAL_ID,
                        :P15_ADDRESS,
                        :P15_CUSTOMER_TYPE,
                        :P15_GENDER
                    )
                    RETURNING CUSTOMER_ID INTO V_CUSTOMER_ID;
                
                    -- Insert customer account
                    INSERT INTO CUSTOMER_ACCOUNTS (
                        CUSTOMER_ID,
                        PASSWORD_HASH,
                        IS_ACTIVE,
                        CREATED_AT
                    )
                    VALUES (
                        V_CUSTOMER_ID,
                        V_PASSWORD_HASH,
                        'Y',
                        SYSDATE
                    );
                
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage:
                ```
                تم التسجيل بنجاح
                
                ```
        }
        advanced {
            executionMappingIdentifier: 14505120353530783042
        }
        serverSideCondition {
            whenButtonPressed: @btn-register
        }
    )

    branch (
        name: go_to_login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
                items: {
                    P9999_USERNAME: &P15_PHONE.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @btn-register
        }
    )

)

