page 5 (
    name: العملاء والسيارات
    alias: العملاء-والسيارات
    title: العملاء والسيارات
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region customers (
        name: بيانات العميل
        type: classicReport
        source {
            location: localDatabase
            tableName: CUSTOMERS
            whereClause: "CUSTOMER_ID" = :P5_CUSTOMER_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_CUSTOMER_ID
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound:
                ```
                اختر عميل
                
                ```
        }

        column ADDRESS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: العنوان
            }
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "ADDRESS" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

        column CUSTOMER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "CUSTOMER_ID" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

        column CUSTOMER_TYPE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: نوع العميل
            }
            lov {
                type: sharedComponent
                lov: @type
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "CUSTOMER_TYPE" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

        column FULL_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: الاسم
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "FULL_NAME" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

        column GENDER (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: النوع
            }
            lov {
                type: sharedComponent
                lov: @النوع
            }
            layout {
                sequence: 7
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "GENDER" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

        column NATIONAL_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: الرقم القومي
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "NATIONAL_ID" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

        column PHONE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: رقم الهاتف
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "CUSTOMERS"
                    where "PHONE" is not null
                    and "CUSTOMER_ID" = :P5_CUSTOMER_ID
                    ```
            }
        )

    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "CUSTOMER_ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P5_CUSTOMER_ID', p_values => "CUSTOMER_ID") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P5_CUSTOMER_ID,'0') = "CUSTOMER_ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("FULL_NAME", 1, 50)||( case when length("FULL_NAME") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("NATIONAL_ID", 1, 50)||( case when length("NATIONAL_ID") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "CUSTOMERS" x
                where (:P5_SEARCH is null
                        or upper(x."FULL_NAME") like '%'||upper(:P5_SEARCH)||'%'
                        or upper(x."NATIONAL_ID") like '%'||upper(:P5_SEARCH)||'%'
                    )
                order by "FULL_NAME"
                ```
            pageItemsToSubmit: P5_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        messages {
            whenNoDataFound:
                ```
                لاتوجد داتا
                
                ```
        }

        column CUSTOMER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Customer Id
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Link Attr
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Link Class
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: List Class
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 9
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

    )

    region no-record-selected (
        name: No Record Selected
        type: staticContent
        source {
            htmlCode: No Record Selected
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_CUSTOMER_ID
        }
    )

    region region-display-selector (
        name: Region Display Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
            cssClasses: js-detail-rds
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_CUSTOMER_ID
        }
        settings {
            rememberSelection: false
        }
    )

    region search (
        name: بحث
        type: staticContent
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: [
                search-region
                padding-md
            ]
        }
    )

    region vehicles (
        name: عربيات العميل
        type: classicReport
        source {
            location: localDatabase
            tableName: VEHICLES
            includeRowidColumn: true
            whereClause: "CUSTOMER_ID" = :P5_CUSTOMER_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_CUSTOMER_ID
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: لا توجد سيارات لهذا العميل
        }

        column COLOR (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: اللون
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

        column CUSTOMER_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 10
            derivedColumn: Y
            type: link
            heading {
                heading: تعديل
            }
            layout {
                sequence: 19
                columnAlignment: end
            }
            link {
                target: {
                    page: 7
                    items: {
                        P7_VEHICLE_ID: #VEHICLE_ID#
                        P7_CUSTOMER_ID: #CUSTOMER_ID#
                        P7_COLOR: #COLOR#
                        P7_MAKE: #MAKE#
                        P7_MODEL: #MODEL#
                        P7_PLATE_NUMBER: #PLATE_NUMBER#
                        P7_VEHICLE_SIZE: #VEHICLE_SIZE#
                        P7_VIN: #VIN#
                        P7_YEAR: #YEAR#
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

        column MAKE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: الماركة
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

        column MODEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: الموديل
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PLATE_NUMBER (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: لوحة السيارة
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

        column VEHICLE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column VEHICLE_SIZE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: الحجم
            }
            lov {
                type: sharedComponent
                lov: @vehicle
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

        column VIN (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: رقم الشاسية
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

        column YEAR (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: السنة
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
        )

    )

    pageItem P5_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 40
            region: @customers
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_SEARCH (
        type: textField
        label {
            label: " بحث بالاسم أو الرقم القومي"
            alignment: left
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--postTextBlock
            ]
            icon: fa-search
            width: 30
            valuePlaceholder: Search...
        }
    )

    button create (
        buttonName: create
        label: عميل جديد
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                clearCache: 6
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button edit (
        buttonName: EDIT
        label: تعديل
        layout {
            sequence: 20
            region: @customers
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            cssClasses: s-btn-outline
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                items: {
                    P6_CUSTOMER_ID: &P5_CUSTOMER_ID.
                }
                clearCache: 6
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: edit_master_btn
        }
    )

    button pop-vehicles (
        buttonName: POP_VEHICLES
        label: إضافة سيارة
        layout {
            sequence: 10
            region: @vehicles
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-car
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 7
                items: {
                    P7_CUSTOMER_ID: &P5_CUSTOMER_ID.
                }
                clearCache: 7
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button reset (
        buttonName: RESET
        label: اعادة تحميل
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-refresh
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
                action: resetPagination
                request: RESET
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @vehicles
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vehicles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-2 (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @customers
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customers
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P5_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

